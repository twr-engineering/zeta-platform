# ===========================================
# Firebase Client Configuration (Public)
# ===========================================
# These are safe to expose client-side
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ===========================================
# Firebase Admin SDK (Server-only - KEEP SECRET)
# ===========================================
# Option 1: Service Account JSON path
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option 2: Inline credentials (for serverless/Vercel)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===========================================
# Gemini API (for image generation)
# ===========================================
GEMINI_API_KEY=your_gemini_api_key

# ===========================================
# MCP Server Configuration
# ===========================================
# Context7 API key (get from https://context7.com)
# Note: Add this to your shell profile (~/.zshrc) for Claude Code to access:
#   export CONTEXT7_API_KEY=ctx7sk-...
CONTEXT7_API_KEY=your_context7_api_key

# ===========================================
# Firestore Namespace (CRITICAL)
# ===========================================
# DEV = "dev" → collections: dev_users, dev_orders, etc.
# PROD = "prod" → collections: prod_users, prod_orders, etc.
# NEVER mix namespaces between environments!
NEXT_PUBLIC_FIRESTORE_NAMESPACE=dev

# ===========================================
# Payment Gateway (SymphPay)
# ===========================================
# DEV: Use staging URL with sandbox/test mode
# PROD: Use production URL with live credentials
SYMPH_PAY_BASE_URL=https://symph-pay-test.df.r.appspot.com/
SYMPH_PAY_API_KEY=your_merchant_api_key
SYMPH_PAY_SECRET_KEY=your_merchant_secret_key
# Test cards for DEV:
#   Stripe: https://docs.stripe.com/testing
#   PayMongo: https://developers.paymongo.com/docs/testing

# ===========================================
# Application Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production URL (set in Vercel/hosting)
# NEXT_PUBLIC_APP_URL=https://your-domain.com
