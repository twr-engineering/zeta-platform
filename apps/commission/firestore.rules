rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPER FUNCTIONS
    // =====================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasSchemaVersion() {
      return request.resource.data.schemaVersion is number
          && request.resource.data.schemaVersion > 0;
    }

    function hasValidTimestamps() {
      return request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
    }

    function onlyUpdates(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // =====================================================
    // DEFAULT: DENY ALL
    // =====================================================
    // CRITICAL: This denies all access by default.
    // You MUST explicitly allow access for each collection below.

    match /{document=**} {
      allow read, write: if false;
    }

    // =====================================================
    // ⚠️ NAMESPACE ISOLATION (CRITICAL!)
    // =====================================================
    // This app uses namespace prefixes for environment isolation:
    //   - DEV:     dev_users, dev_posts, etc.
    //   - STAGING: staging_users, staging_posts, etc.
    //   - PROD:    prod_users, prod_posts, etc.
    //
    // The namespace is set via NEXT_PUBLIC_FIRESTORE_NAMESPACE env var.
    // 
    // YOU MUST ADD RULES FOR EACH NAMESPACE YOU USE!
    // Copy the dev_ rules and create prod_ versions before deploying.
    // =====================================================

    // =====================================================
    // DEV NAMESPACE (dev_*)
    // =====================================================

    // Users collection
    match /dev_users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && hasSchemaVersion()
                    && request.resource.data.email is string;
      allow update: if isOwner(userId)
                    && hasSchemaVersion()
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // User preferences/settings
    match /dev_preferences/{prefId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasSchemaVersion();
      allow update: if isAuthenticated() && hasSchemaVersion();
      allow delete: if false;
    }

    // =====================================================
    // ADD YOUR APP-SPECIFIC COLLECTIONS HERE
    // =====================================================
    // Example for a posts collection:
    //
    // match /dev_posts/{postId} {
    //   allow read: if isAuthenticated();
    //   allow create: if isAuthenticated() 
    //                 && hasSchemaVersion()
    //                 && request.resource.data.authorId == request.auth.uid;
    //   allow update: if isAuthenticated()
    //                 && resource.data.authorId == request.auth.uid
    //                 && hasSchemaVersion();
    //   allow delete: if resource.data.authorId == request.auth.uid;
    // }

    // =====================================================
    // PROD NAMESPACE (prod_*)
    // =====================================================
    // IMPORTANT: Copy all dev_ rules here with prod_ prefix
    // before deploying to production!

    match /prod_users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && hasSchemaVersion()
                    && request.resource.data.email is string;
      allow update: if isOwner(userId)
                    && hasSchemaVersion()
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /prod_preferences/{prefId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasSchemaVersion();
      allow update: if isAuthenticated() && hasSchemaVersion();
      allow delete: if false;
    }

    // =====================================================
    // STAGING NAMESPACE (staging_*) - Optional
    // =====================================================
    // Add staging_ rules here if you use a staging environment.

  }
}
