{
  "name": "zeta-gci-collections",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "NEXT_DIST_DIR=.next-build next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --import ./tests/alias-hooks.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:engine": "node --import ./tests/alias-hooks.mjs --test \"tests/unit/engine/**/*.test.ts\"",
    "test:engine:coverage": "node --import ./tests/alias-hooks.mjs --experimental-test-coverage --test-coverage-include='src/lib/engine/**' --test \"tests/unit/engine/**/*.test.ts\"",
    "test:perf": "node --import ./tests/alias-hooks.mjs --test \"tests/unit/perf.test.ts\"",
    "seed:dev": "node scripts/seed-dev.mjs",
    "perf:recompute": "node --import ./tests/alias-hooks.mjs scripts/perf-recompute.ts",
    "perf:receivables": "node --import ./tests/alias-hooks.mjs scripts/perf-receivables.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.25.0",
    "next": "15.5.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "fast-check": "^4.9.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
