{
  "name": "zeta-platform",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "cms": "pnpm --filter ./apps/cms",
    "commission": "pnpm --filter ./apps/commission",
    "comps": "pnpm --filter ./apps/comps",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm --filter ./apps/cms typecheck",
    "test": "pnpm --filter ./apps/cms test && pnpm --filter ./apps/commission test:unit"
  }
}
